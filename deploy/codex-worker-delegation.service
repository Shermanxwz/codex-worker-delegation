[Unit]
Description=Codex Worker Delegation local control plane
Documentation=https://github.com/Shermanxwz/codex-worker-delegation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@@INSTALL_ROOT@@/current
Environment=HOME=@@HOME@@
Environment=CODEX_HOME=@@CODEX_HOME@@
Environment=CWD_HOST=127.0.0.1
Environment=CWD_PORT=8788
Environment=CWD_REQUIRE_AUTH=1
Environment=PATH=@@HOME@@/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=CWD_NODE_BIN=@@INSTALL_ROOT@@/runtime/node
ExecStart=@@INSTALL_ROOT@@/current/scripts/service-entry.sh
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
UMask=0077

# Harden the control plane without making delegated workspaces read-only.
# ProtectSystem=strict is intentionally not used because delegated Codex
# workers must retain normal write access to explicitly selected workspaces.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
