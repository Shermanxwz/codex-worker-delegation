[Unit]
Description=Codex Worker Delegation local control plane
Documentation=https://github.com/Shermanxwz/codex-worker-delegation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/codex-worker-delegation/current
Environment=CWD_HOST=127.0.0.1
Environment=CWD_PORT=8788
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/share/codex-worker-delegation/current/scripts/service-entry.sh
Restart=on-failure
RestartSec=2
TimeoutStopSec=20
UMask=0077

# User-service hardening. The service intentionally keeps the user's home
# reachable because Codex must access ~/.codex and delegated workspace paths.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
